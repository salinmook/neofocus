<div class="profile-page">
<%= link_to menu_path, class: "home-btn" do %>
  &#8962;
<% end %>

<h1 class="profile-title">Your Profile</h1>
<%= form_with model: @user, url: profile_update_path, method: :patch, id: "profile-form",
 local: false do |f| %>

<div class="profile-header">
  <div class="avatar-wrapper">
    <% initial_index = (1..5).to_a.find_index { |i| "profile-avatar-#{i}" ==
  @user.avatar } || 0 %>
    <div class="avatar-slider-container" data-initial-index="<%= initial_index %>">
      <% (1..5).each do |i| %>
        <% avatar_name = "profile-avatar-#{i}" 
         is_checked = (@user.avatar == avatar_name) ||  (@user.avatar.blank? && i == 1) %>
        <label class="avatar-item" for="avatar_<%= i %>">
          <%= f.radio_button :avatar, avatar_name, 
          id: "avatar_#{i}",
          class: "auto-save-radio",
          checked: is_checked %>
          <%= image_tag "#{avatar_name}.png", class: "avatar-option-img 
          #{'active' if is_checked}", alt: "Avatar #{i}" %>
        </label>
        <% end %>
    </div>
    <button type="button" class="arrow right" onclick="nextSlide()">></button>
  </div>
</div>
  


    <div class="name-input-section">
      <%= f.text_field :name, class: "auto-save-input", placeholder: "Type your name here" %>
    </div>
    <% end %>
   

    <p class="total-score-text gold-total-box">TOTAL SCORE: <span><%= @total_score %></span></p>
    <% @levels.each do |level| %>
    <div class="level-card row-layout 
    <%= 'is-locked' unless @user.level_unlocked?(level) %>">Level
      <div class="level-number star-badge"><%= level.level_number %>
      </div>
      <div class="score-info-center">
        <% score = @user.high_score_for(level) || 0 %>
        <% if score > 0 %>
          <div class="gold-score-box">BEST SCORE: <%= score %>
          </div>
        <% else %>
          <p class="gold-score-box">No Score</p>
        <% end %>
      </div>
     
</div>
<% end %>
</div>
