<div class="lost-container" style="background-image: asset-url('lost-background.png');">
  <div class="lost-header">
<%= image_tag "lost-avatar.png", class: "lost-avatar" %>
      <h1 class="encourage-text"><%= @message %></h1>
    </div>

  <div class="lost-card">
    <div class="stat-row">  
      <span class="stat-label">HITS:</span>
      <span class="stat-value"><%= @hits %></span>
    </div>
    <div class="stat-row">
      <span class="stat-label">SCORE:</span>
      <span class="stat-value"><%= @score %>Points</span> 
    </div>
      
      <div class="action-buttons">
        <%= link_to level_path(@level), class: "btn-blue" do %>
          TRY AGAIN <i class="fas fa-redo"></i>
          <% end %>
        <%= link_to menu_path, class: "btn-green" do %>
          <span>MAIN MENU</span> <i class="fas fa-home"></i>
          <% end %>
      </div>
  </div>
</div>

<style>
.lost-container {
  background-image: url('<%= asset_path("lost-background.png") %>');
  background-size: cover;
    background-position: center;
    min-height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
   
}
.lost-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    margin-bottom: -100px;
    z-index: 10;
    margin-top: 35px;
}
.lost-avatar {
    width: 110px;
    height: auto;
    margin-bottom: 8px;
    margin-top: -10px;
    display: block;
    position: relative;
    transform: translateX(4px);
   }
  
.encourage-text {
    background: linear-gradient(
        90deg,
        #1E3A8A 0%,
        #3B82F6 25%,
        #60A5FA 45%,
        #DBEAFE 55%,
        #60A5FA 70%,
        #3B82F6 85%,
        #1E3A8A 100%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: Shine 8s linear infinite;
    font-size: 1.8rem;
    font-weight: 900;
    text-shadow: 0 0 0 5px rgba(255, 225, 225, 0.2),
    text-transform: uppercase;
    margin: 0 0 0 0;
}
@keyframes Shine {
    0% { background-position: 0% center;}
    50% {background-position: 100% center;}
    100% {background-position: 0% center;}
}
.lost-card {
    background: rgba(255, 255, 255, 0.6);
    border: 4px solid #FFFFFF;
    border-radius: 40px;
    width: 85%;
    max-width: 350px;
    min-height: 70vh;
    padding: 80px 20px 20px 20px;
    box-shadow:  0 10px 25px rgba(0,0,0,0.2);
    margin-bottom: 30px;
    margin-top: 0;
    z-index: 1;
}
.stat-row {
    background: linear-gradient(180deg, #FFFFFF 0%, #f0f4f7 15%, #d8e1e9 50%,
    #b9c5d1 100%);
    border: 2px solid #aebccb;
    border-bottom: 2px solid #9aa5b1;
    border-radius: 15px;
    box-shadow: inset 0 1px 0 #FFFFFF, inset 0 -1px 3px #cdd6e0,
    0 4px 10px rgba(0,0,0,0.08), 0 1px 1px rgba(0,0,0,0.1) ;
    padding: 8px 15px;
    margin-bottom: 20px;
    margin-top: 25px;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    overflow: hidden;
    &::before {
        font-family: "Font Awesome 5 Free", "Font Awesome 6 Free";
        font-weight: 900;
        font-size: 1.5rem;
        margin-right: 0;
        z-index: 1;
        width: 30px;
        text-align: center;
        display: inline-block;
        text-shadow:  0 1px 0 #FFFFFF;
        filter: drop-shadow(0 1px 1px rgba(0,0,0,0.2));
        &::after {
            content: "";
            position: absolute;
            top: 0; left: 0; right: 0; height: 50%;
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.4) 0%,
            rgba(255,255,255,0) 100%);
            pointer-events: none;
        }
    }
}
.stat-row:nth-of-type(1)::before {
    content: "\f140";
    color: #C19C4A
    
}
.stat-row:nth-of-type(2)::before {
    content: "\f51e";
    color: #D6A846
}
.stat-label {

    font-weight: 800;
    color: #475569;
    font-size: 1.2rem;
    margin-left: 5px;
    padding-left: -30px;
    text-shadow: 0 1px 0 #FFFFFF;
    
}
.stat-value {
    text-align: center;
    font-weight: 900;
    color: #1e293b;
    font-size: 1.2rem;
    padding-left: 5px;
    text-shadow: 0 1px 0 #FFFFFF;
}
.action-buttons a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 25px;
    margin-bottom: 20px;
    border-radius: 20px;
    text-decoration: none !important;
    color: white !important;
    font-weight: 900;
    font-size: 1.2rem;
    box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    width: 100%;
}
.btn-blue {
    background: linear-gradient(to bottom, #4AA3DF, #2E7BB0);
    border-bottom: 4px solid #1A5A8A;
}
.btn-green {
    background: linear-gradient(to bottom, #56C596, #3B9471);
    border-bottom: 4px solid #286950;
}

</style>